<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>de.vinzens.lumen</groupId>
	<artifactId>lumen-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>lumen-parent</name>
	<description>Lumen DMX/Art-Net lighting control</description>

	<modules>
		<module>lumen-domain</module>
		<module>lumen-application</module>
		<module>lumen-adapter-library-yaml</module>
		<module>lumen-adapter-sqlite</module>
		<module>lumen-adapter-artnet</module>
		<module>lumen-adapter-web</module>
		<module>lumen-frontend</module>
		<module>lumen-app</module>
	</modules>

	<properties>
		<java.version>26</java.version>
		<archunit.version>1.5.1</archunit.version>
		<!-- run spring-boot:run only in lumen-app, not in the other modules -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
		<!-- sqlite-jdbc loads a native library (JNI) -->
		<argLine>--enable-native-access=ALL-UNNAMED</argLine>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-application</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-adapter-library-yaml</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-adapter-sqlite</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-adapter-artnet</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-adapter-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-frontend</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<!-- keeps passing tests quiet (e.g. Flyway migrations), lumen-app uses logback-test.xml -->
						<java.util.logging.config.file>${maven.multiModuleProjectDirectory}/.mvn/test-logging.properties</java.util.logging.config.file>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
