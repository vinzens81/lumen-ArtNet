<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>de.vinzens.lumen</groupId>
	<artifactId>lumen-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>lumen-parent</name>
	<description>Lumen DMX/Art-Net Lichtsteuerung</description>

	<modules>
		<module>lumen-domain</module>
		<module>lumen-application</module>
		<module>lumen-adapter-library-yaml</module>
		<module>lumen-adapter-web</module>
		<module>lumen-app</module>
	</modules>

	<properties>
		<java.version>26</java.version>
		<archunit.version>1.5.1</archunit.version>
		<!-- spring-boot:run nur in lumen-app ausführen, nicht in den übrigen Modulen -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-application</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-adapter-library-yaml</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>de.vinzens.lumen</groupId>
				<artifactId>lumen-adapter-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
